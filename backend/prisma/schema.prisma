// SPQR Inventory Management — Prisma schema
// Source of truth: docs/03-Data-Model.md. Extend here first, then write module code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Platform / Organization ----------

model Organization {
  id               String    @id @default(uuid())
  name             String    @unique
  subscriptionPlan String    @default("standard") @map("subscription_plan")
  status           String    @default("pending") // pending | active | suspended
  logoUrl          String?   @map("logo_url")
  contactInfo      Json?     @map("contact_info")
  businessHours    Json?     @map("business_hours")
  activationTokenHash      String?   @map("activation_token_hash")
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  isActive         Boolean   @default(true) @map("is_active")

  users               User[]
  roles               Role[]
  buildings           Building[]
  departments         Department[]
  positions           Position[]
  employeeCategories  EmployeeCategory[]
  inventoryCategories InventoryCategory[]
  itemPolicies        ItemPolicy[]
  notificationSettings NotificationSetting[]
  approvalWorkflows   ApprovalWorkflow[]
  stockThresholds     StockThreshold[]
  employees           Employee[]
  vendors             Vendor[]
  inventoryItems      InventoryItem[]
  auditLogs           AuditLog[]
  attachments         Attachment[]
  notifications       Notification[]
  importJobs          ImportJob[]
  exportJobs          ExportJob[]
  procurementRequests ProcurementRequest[]
  indents             Indent[]
  purchaseOrders      PurchaseOrder[]
  vendorRatings       VendorRating[]
  approvalActions     ApprovalAction[]
  itemIssuances       ItemIssuance[]
  itemReturns         ItemReturn[]
  lostDamagedReports  LostDamagedReport[]
  recoveryCalculations RecoveryCalculation[]

  @@map("organizations")
}

// ---------- Identity & Access ----------

model User {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id])
  username           String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  resetTokenHash     String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  isActive           Boolean   @default(true) @map("is_active")

  roles           UserRole[]
  passwordHistory PasswordHistory[]
  sessions        Session[]
  employee        Employee?

  @@map("users")
}

model Role {
  id               String   @id @default(uuid())
  organizationId    String?  @map("organization_id") // null = platform/system-defined role
  organization      Organization? @relation(fields: [organizationId], references: [id])
  name              String
  isSystemDefined   Boolean  @default(false) @map("is_system_defined")
  createdAt         DateTime @default(now()) @map("created_at")
  isActive          Boolean  @default(true) @map("is_active")

  permissions RolePermission[]
  users       UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  module String
  screen String @default("") // "" = module-level permission, not screen-specific
  action String // create|view|update|delete|approve|export

  roles RolePermission[]

  @@unique([module, screen, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String   @map("password_hash")
  changedAt    DateTime @default(now()) @map("changed_at")

  @@map("password_history")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  ip               String?
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// ---------- Master Data / Configuration ----------

model Building {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  location       String?
  floors         Int?
  isActive       Boolean @default(true) @map("is_active")

  employees Employee[]

  @@unique([organizationId, code])
  @@map("buildings")
}

model Department {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String?
  isActive       Boolean @default(true) @map("is_active")

  employees Employee[]
  indents   Indent[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Position {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean @default(true) @map("is_active")

  employees Employee[]

  @@unique([organizationId, name])
  @@map("positions")
}

model EmployeeCategory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean @default(true) @map("is_active")

  employees Employee[]

  @@unique([organizationId, name])
  @@map("employee_categories")
}

model InventoryCategory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean @default(true) @map("is_active")

  items    InventoryItem[]
  policies ItemPolicy[]

  @@unique([organizationId, name])
  @@map("inventory_categories")
}

model ItemPolicy {
  id                  String  @id @default(uuid())
  organizationId      String  @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  inventoryCategoryId String  @map("inventory_category_id")
  inventoryCategory   InventoryCategory @relation(fields: [inventoryCategoryId], references: [id])
  annualAllocation    Int     @map("annual_allocation")
  replacementFrequency String? @map("replacement_frequency")
  recoveryPolicy      Json?   @map("recovery_policy")
  usefulLifeMonths    Int?    @map("useful_life_months")
  recoverableValue    Decimal? @map("recoverable_value") @db.Decimal(12, 2)
  isActive            Boolean @default(true) @map("is_active")

  issuances ItemIssuance[]

  @@map("item_policies")
}

model NotificationSetting {
  id                String @id @default(uuid())
  organizationId    String @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])
  channel           String // email | bell | sms | push
  reminderFrequency String? @map("reminder_frequency")
  escalationRules   Json?   @map("escalation_rules")
  isActive          Boolean @default(true) @map("is_active")

  @@map("notification_settings")
}

model ApprovalWorkflow {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  processType      String @map("process_type") // procurement | indent
  levels           Json   // ordered list of role names
  escalationHours  Int    @default(24) @map("escalation_hours")
  delegationRules  Json?  @map("delegation_rules")
  isActive         Boolean @default(true) @map("is_active")

  @@map("approval_workflows")
}

model StockThreshold {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  inventoryItemId  String? @map("inventory_item_id")
  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  lowStockQty      Int     @default(20) @map("low_stock_qty")
  criticalStockQty Int     @default(5) @map("critical_stock_qty")
  isActive         Boolean @default(true) @map("is_active")

  @@map("stock_thresholds")
}

// ---------- Employees ----------

model Employee {
  id                 String  @id @default(uuid())
  organizationId     String  @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id])
  userId             String? @unique @map("user_id")
  user               User?   @relation(fields: [userId], references: [id])
  employeeCode       String  @map("employee_code")
  name               String
  joiningDate        DateTime @map("joining_date")
  leavingDate        DateTime? @map("leaving_date")
  buildingId         String? @map("building_id")
  building           Building? @relation(fields: [buildingId], references: [id])
  departmentId       String? @map("department_id")
  department         Department? @relation(fields: [departmentId], references: [id])
  positionId         String? @map("position_id")
  position           Position? @relation(fields: [positionId], references: [id])
  employeeCategoryId String? @map("employee_category_id")
  employeeCategory   EmployeeCategory? @relation(fields: [employeeCategoryId], references: [id])
  status             String  @default("active") // active|transferred|leaving|exited|rehired
  createdAt          DateTime @default(now()) @map("created_at")
  isActive           Boolean @default(true) @map("is_active")

  transfers EmployeeTransfer[]
  history   EmployeeHistoryEvent[]
  itemIssuances        ItemIssuance[]
  lostDamagedReports   LostDamagedReport[]
  recoveryCalculations RecoveryCalculation[]

  @@unique([organizationId, employeeCode])
  @@map("employees")
}

model EmployeeTransfer {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id])
  fromBuildingId   String?  @map("from_building_id")
  toBuildingId     String?  @map("to_building_id")
  fromDepartmentId String?  @map("from_department_id")
  toDepartmentId   String?  @map("to_department_id")
  approvedBy       String?  @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("employee_transfers")
}

model EmployeeHistoryEvent {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  eventType  String   @map("event_type")
  details    Json?
  eventAt    DateTime @default(now()) @map("event_at")

  @@map("employee_history")
}

// ---------- Vendor & Procurement (schema-only for now; logic built in a later module pass) ----------

model Vendor {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  documents        Json?
  status           String @default("pending") // pending|verified|approved
  performanceScore Decimal? @db.Decimal(5, 2) @map("performance_score")
  isActive         Boolean @default(true) @map("is_active")

  ratings        VendorRating[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model InventoryItem {
  id                  String @id @default(uuid())
  organizationId      String @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  itemCode            String @map("item_code")
  name                String
  inventoryCategoryId String? @map("inventory_category_id")
  inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
  unitCost            Decimal? @db.Decimal(12, 2) @map("unit_cost")
  currentStockQty     Int    @default(0) @map("current_stock_qty")
  isActive            Boolean @default(true) @map("is_active")

  stockThresholds StockThreshold[]
  issuances       ItemIssuance[]
  lostDamagedReports LostDamagedReport[]

  @@unique([organizationId, itemCode])
  @@map("inventory_items")
}

model ProcurementRequest {
  id                  String @id @default(uuid())
  organizationId      String @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  sourceType          String @map("source_type") // low_stock|critical_stock|indent
  inventoryItemId     String? @map("inventory_item_id")
  quantity            Int
  status              String @default("pending")
  currentApprovalLevel Int   @default(0) @map("current_approval_level")
  cancelledReason     String? @map("cancelled_reason")
  createdAt           DateTime @default(now()) @map("created_at")

  purchaseOrders PurchaseOrder[]

  @@map("procurement_requests")
}

model Indent {
  id                  String @id @default(uuid())
  organizationId      String @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  departmentId        String? @map("department_id")
  department          Department? @relation(fields: [departmentId], references: [id])
  raisedBy            String? @map("raised_by")
  items               Json
  status              String @default("pending")
  currentApprovalLevel Int   @default(0) @map("current_approval_level")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("indents")
}

model PurchaseOrder {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id])
  procurementRequestId String   @map("procurement_request_id")
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id])
  vendorId             String   @map("vendor_id")
  vendor               Vendor   @relation(fields: [vendorId], references: [id])
  status               String   @default("issued") // issued|received|cancelled
  totalAmount          Decimal? @db.Decimal(12, 2) @map("total_amount")
  poNumber             String   @map("po_number")
  createdAt            DateTime @default(now()) @map("created_at")

  ratings VendorRating[]

  @@map("purchase_orders")
}

model VendorRating {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  vendorId        String   @map("vendor_id")
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?  @map("purchase_order_id")
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  deliveryRating  Int      @map("delivery_rating") // 1-5
  qualityRating   Int      @map("quality_rating")  // 1-5
  priceRating     Int      @map("price_rating")    // 1-5
  ratedAt         DateTime @default(now()) @map("rated_at")

  @@map("vendor_ratings")
}

// Generic approval-chain ledger (WF7 Purchase, WF17 Indent, WF21 Escalation).
// entityType/entityId is a deliberately loose polymorphic reference (not a
// Prisma relation) so the same engine drives multiple approval-gated
// processes without a table per process - see 02-Architecture.md Section 5.
model ApprovalAction {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String    @map("entity_type") // procurement_request | indent
  entityId       String    @map("entity_id")
  level          Int
  approverUserId String?   @map("approver_user_id")
  decision       String    @default("pending") // pending|approved|rejected|escalated
  actedAt        DateTime? @map("acted_at")
  slaDueAt       DateTime? @map("sla_due_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("approval_actions")
}

model ItemIssuance {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  inventoryItemId String   @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  issuedAt        DateTime @default(now()) @map("issued_at")
  issuedBy        String?  @map("issued_by")
  signatureRef    String?  @map("signature_ref")
  policyId        String?  @map("policy_id")
  policy          ItemPolicy? @relation(fields: [policyId], references: [id])

  returns ItemReturn[]

  @@map("item_issuances")
}

model ItemReturn {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  itemIssuanceId String   @map("item_issuance_id")
  itemIssuance   ItemIssuance @relation(fields: [itemIssuanceId], references: [id])
  quantity       Int
  returnedAt     DateTime @default(now()) @map("returned_at")
  condition      String   // good|damaged
  inspectedBy    String?  @map("inspected_by")
  disposition    String   // restock|scrap|repair

  @@map("item_returns")
}

model LostDamagedReport {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])
  employeeId        String    @map("employee_id")
  employee          Employee  @relation(fields: [employeeId], references: [id])
  inventoryItemId   String    @map("inventory_item_id")
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  itemIssuanceId    String?   @map("item_issuance_id")
  type              String    // lost|damaged
  reportedAt        DateTime  @default(now()) @map("reported_at")
  managerVerifiedBy String?   @map("manager_verified_by")
  recoveryAmount    Decimal?  @db.Decimal(12, 2) @map("recovery_amount")
  financeApprovedBy String?   @map("finance_approved_by")
  replacementIssued Boolean   @default(false) @map("replacement_issued")

  @@map("lost_damaged_reports")
}

model RecoveryCalculation {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  employeeId          String    @map("employee_id")
  employee            Employee  @relation(fields: [employeeId], references: [id])
  sourceType          String    @map("source_type") // exit|loss|damage
  itemIssuanceId      String?   @map("item_issuance_id")
  joinDate            DateTime? @map("join_date")
  leaveOrIncidentDate DateTime? @map("leave_or_incident_date")
  policyId            String?   @map("policy_id")
  calculatedAmount    Decimal   @db.Decimal(12, 2) @map("calculated_amount")
  financeVerifiedBy   String?   @map("finance_verified_by")
  financeVerifiedAt   DateTime? @map("finance_verified_at")
  salaryDeductionRef  String?   @map("salary_deduction_ref")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("recovery_calculations")
}

// ---------- Audit, Notifications, Attachments, Ops ----------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  action         String
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@map("audit_logs")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?  @map("user_id")
  channel        String   // email|bell|sms|push
  eventType      String   @map("event_type")
  payload        Json?
  readAt         DateTime? @map("read_at")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Attachment {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  fileUrl         String   @map("file_url")
  fileName        String   @map("file_name")
  mimeType        String?  @map("mime_type")
  virusScanStatus String   @default("pending") @map("virus_scan_status")
  uploadedBy      String?  @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  @@map("attachments")
}

model ImportJob {
  id            String   @id @default(uuid())
  organizationId String  @map("organization_id")
  organization  Organization @relation(fields: [organizationId], references: [id])
  module        String
  fileRef       String?  @map("file_ref")
  status        String   @default("pending")
  totalRows     Int?     @map("total_rows")
  successRows   Int?     @map("success_rows")
  errorRows     Int?     @map("error_rows")
  errorReportRef String? @map("error_report_ref")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("import_jobs")
}

model ExportJob {
  id            String   @id @default(uuid())
  organizationId String  @map("organization_id")
  organization  Organization @relation(fields: [organizationId], references: [id])
  module        String
  format        String   // xlsx|csv|pdf
  filters       Json?
  fileRef       String?  @map("file_ref")
  requestedBy   String?  @map("requested_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("export_jobs")
}

// ---------- Platform-level (Sparquer) ----------

model SuperAdmin {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  isActive           Boolean   @default(true) @map("is_active")

  @@map("super_admins")
}

model BackupJob {
  id                String   @id @default(uuid())
  startedAt         DateTime @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  storageRef        String?  @map("storage_ref")
  encrypted         Boolean  @default(true)
  retentionExpiresAt DateTime? @map("retention_expires_at")
  verified          Boolean  @default(false)

  @@map("backup_jobs")
}
