NODE_ENV=development
PORT=4000

# PostgreSQL connection (Prisma)
DATABASE_URL=postgresql://spqr:spqr_dev_password@localhost:5432/spqr_inventory

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session / security policy (defaults match BRD FR-5/FR-6)
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=5
MAX_FAILED_LOGIN_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
TEMP_PASSWORD_TTL_HOURS=24

# Email (swap for SES / Azure Communication Services in production - see deployment guides)
MAIL_PROVIDER=console
MAIL_FROM=no-reply@spqr-inventory.example

# File storage (swap for S3 / Azure Blob in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173
